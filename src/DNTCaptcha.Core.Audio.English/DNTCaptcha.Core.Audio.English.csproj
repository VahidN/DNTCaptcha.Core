<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DNTCaptchaTargetFrameworks)</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VersionPrefix>5.3.4</VersionPrefix>
    <Authors>Vahid Nasiri</Authors>
    <Description>Optional English digit recordings and WAV audio provider for DNTCaptcha.Core.</Description>
    <PackageId>DNTCaptcha.Core.Audio.English</PackageId>
    <PackageLicenseExpression>Apache-2.0 AND CC-BY-4.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/VahidN/DNTCaptcha.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VahidN/DNTCaptcha.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DNTCaptcha.Core/DNTCaptcha.Core.csproj" />
    <EmbeddedResource Include="Resources/Male/*.wav"
                      LogicalName="DNTCaptcha.Core.Audio.English.Male.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/Female/*.wav"
                      LogicalName="DNTCaptcha.Core.Audio.English.Female.%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="NOTICE.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
